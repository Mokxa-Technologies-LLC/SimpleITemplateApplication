        {"className": "menu-component"},
        {
            "className": "org.joget.plugin.enterprise.HtmlCodeComponent",
            "properties": {
                "attr-data-events-listening": [],
                "textContent": "<html>\r\n<head>\r\n    <style>\r\n        #globe_container {\r\n            width: 100%;\r\n            height: 100%;\r\n            position: fixed;\r\n            top: 100px;\r\n            z-index: -1;\r\n            left: 490px;\r\n        }\r\n    <\/style>\r\n    <script src=\"https://unpkg.com/globe.gl\"><\/script>\r\n<\/head>\r\n<body>\r\n    <div id=\"globe_container\"><\/div>\r\n    <script>\r\n        const globe = Globe()\r\n            .backgroundColor('#f9f9f9')\r\n            .showAtmosphere(true)\r\n            .atmosphereColor('#87ceeb')\r\n            .atmosphereAltitude(0.25)\r\n            .hexPolygonsData([])\r\n            .hexPolygonResolution(3)\r\n            .hexPolygonMargin(0.4)\r\n            .hexPolygonColor(() => '#9ca0b5')\r\n            .onGlobeReady(() => {\r\n            console.log('Auto-Rotating Globe is ready!');\r\n        });\r\n    \r\n        globe(document.getElementById('globe_container'));\r\n    \r\n        fetch('https://raw.githubusercontent.com/datasets/geo-countries/main/data/countries.geojson')\r\n            .then((res) => res.json())\r\n            .then((countries) => {\r\n                console.log('Country data loaded:', countries.features.length);\r\n                globe.hexPolygonsData(countries.features); // Set the GeoJSON data\r\n            })\r\n            .catch((err) => console.error('Failed to load GeoJSON data:', err));\r\n    \r\n        const autoRotateSpeed = 0.2;\r\n        let isInteracting = false;\r\n    \r\n        function spinGlobe() {\r\n            if (!isInteracting) {\r\n                const currentPOV = globe.pointOfView();\r\n                globe.pointOfView({ lat: currentPOV.lat, lng: currentPOV.lng + autoRotateSpeed }, 50);\r\n            }\r\n            requestAnimationFrame(spinGlobe);\r\n        }\r\n        spinGlobe();\r\n    \r\n        let isDragging = false;\r\n        let previousMouseX, previousMouseY;\r\n    \r\n        document.addEventListener('mousedown', (event) => {\r\n            isDragging = true;\r\n            isInteracting = true;\r\n            previousMouseX = event.clientX;\r\n            previousMouseY = event.clientY;\r\n            event.preventDefault();\r\n        });\r\n    \r\n        document.addEventListener('mousemove', (event) => {\r\n            if (isDragging) {\r\n                const deltaX = event.clientX - previousMouseX;\r\n                const deltaY = event.clientY - previousMouseY;\r\n        \r\n                globe.pointOfView({\r\n                    lat: globe.pointOfView().lat + deltaY * 0.1,\r\n                    lng: globe.pointOfView().lng - deltaX * 0.1,\r\n                });\r\n        \r\n                previousMouseX = event.clientX;\r\n                previousMouseY = event.clientY;\r\n            }\r\n        });\r\n    \r\n        document.addEventListener('mouseup', () => {\r\n            isDragging = false;\r\n            isInteracting = false;\r\n        });\r\n    \r\n        document.addEventListener('mouseleave', () => {\r\n            isDragging = false;\r\n            isInteracting = false;\r\n        });\r\n    <\/script>\r\n<\/body>\r\n<\/html>",
                "id": "4520DD6927124EFAB4E45E23C8321FC0",
                "customId": "globe_block"
            }
        }
    ],
