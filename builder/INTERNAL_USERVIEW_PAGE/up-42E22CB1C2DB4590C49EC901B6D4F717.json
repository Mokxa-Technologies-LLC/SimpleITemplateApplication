                            {
                                "className": "org.joget.marketplace.EChartMenu",
                                "properties": {
                                    "xAxisDisplayAS": "time",
                                    "showLegend": "true",
                                    "showToolTip": "",
                                    "enableOffline": "",
                                    "title": "",
                                    "libraryVersion": "5.1.2",
                                    "customId": "sales_by_month_chart",
                                    "chartHeight": "300px",
                                    "mapping_x": "date",
                                    "categoryAxisLabel": "Date",
                                    "horizontal": "",
                                    "theme": "dark",
                                    "id": "B845531E613B4E263E1C434AFEE6DC76",
                                    "customHeader": "<style>\n    [id^='chart-'] canvas {\n        border-radius: 10px !important;\n    }\n<\/style>\n<script>\n    var data =  #datalist.json.dashboard_2_sales_by_month_list#;\n    \n    var groupedData = data.reduce((acc, curr) => {\n        var date = new Date(curr.Date);\n        if (isNaN(date)) return acc;\n        \n        var month = date.toLocaleString('default', { month: 'short' });\n        if (!acc[month]) acc[month] = [];\n        acc[month].push({ date: curr.Date, sales: parseFloat(curr.Sales) });\n        return acc;\n    }, {});\n    \n    var categories = Object.keys(groupedData);\n    var barData = categories.map(month => groupedData[month].reduce((sum, item) => sum + item.sales, 0));\n    var lineData = categories.map(month => barData[categories.indexOf(month)] / groupedData[month].length);\n    \n    setTimeout(() => {\n        var chartDom = document.querySelector(\"[id^='chart-']\");\n        if (chartDom) {\n            var myChart = echarts.init(chartDom);\n            var option = {\n                backgroundColor: {\n                    type: 'linear',\n                    x: 0,\n                    y: 0,\n                    x2: 1,\n                    y2: 1,\n                    colorStops: [\n                        { offset: 0, color: '#1f1b51' },\n                        { offset: 1, color: '#0d1b33' }\n                    ]\n                },\n                borderRadius: 15,\n                tooltip: {\n                    trigger: 'axis',\n                    axisPointer: { type: 'shadow' },\n                    backgroundColor: 'rgba(0, 0, 0, 0.8)',\n                    borderColor: '#333',\n                    borderWidth: 1,\n                    textStyle: {\n                        color: '#fff',\n                        fontSize: 12,\n                        fontFamily: 'Arial, sans-serif'\n                    },\n                    formatter: function (params) {\n                        const totalSales = params.find(p => p.seriesName === 'Total Sales');\n                        const averageSales = params.find(p => p.seriesName === 'Average Sales');\n                        return `<b>${params[0].name}<\/b><br/>\n                            <span style=\"display: inline-block; width: 10px; height: 10px; background-color: #fff; border-radius: 20%; margin-right: 5px;\"><\/span>\n                            Total Sales: ${totalSales ? totalSales.value : 'N/A'}<br/>\n                            <span style=\"display: inline-block; width: 10px; height: 10px; background-color: #ff9a9e; border-radius: 50%; margin-right: 5px;\"><\/span>\n                            Average Sales: ${averageSales ? averageSales.value.toFixed(2) : 'N/A'}`;\n                    }\n                },\n                legend: {\n                    data: ['Total Sales', 'Average Sales'],\n                    top: 20,\n                    textStyle: { \n                        color: '#fff',\n                        fontSize: 14\n                    }\n                },\n                xAxis: {\n                    type: 'category',\n                    data: categories,\n                    axisLine: { show: false },\n                    axisLabel: { show: false },\n                    axisTick: { show: false }\n                },\n                yAxis: {\n                    type: 'value',\n                    axisLine: { lineStyle: { color: '#fff' } },\n                    axisLabel: { \n                        color: '#fff',\n                        fontSize: 14,\n                    },\n                    splitLine: { show: false },\n                    interval: 200\n                },\n                series: [{\n                    name: 'Total Sales',\n                    type: 'bar',\n                    data: barData,\n                    barWidth: 10,\n                    itemStyle: {\n                        color: \"#fff\",\n                        borderRadius: 5\n                    },\n                    universalTransition: {\n                        enabled: true,\n                        divideShape: 'clone'\n                    }\n                },\n                {\n                    name: 'Average Sales',\n                    type: 'line',\n                    data: lineData,\n                    smooth: true,\n                    lineStyle: { color: '#ff9a9e' },\n                    itemStyle: {\n                        color: '#ff9a9e',\n                        borderColor: '#ff9a9e',\n                        borderWidth: 2\n                    },\n                    symbol: 'circle',\n                    symbolSize: 8\n                }]\n            };\n            \n            // myChart.on('click', function (event) {\n            //     const month = event.name;\n            //     if (!groupedData[month]) return;\n            \n            //     const drilldownData = groupedData[month].map(item => ({\n            //         name: item.date,\n            //         value: item.sales\n            //     }));\n            \n            //     myChart.setOption({\n            //         xAxis: {\n            //             type: 'category',\n            //             data: drilldownData.map(d => d.name),\n            //             axisLine: { lineStyle: { color: '#333' } }\n            //         },\n            //         yAxis: {\n            //             type: 'value',\n            //             axisLine: { lineStyle: { color: '#333' } },\n            //             splitLine: { lineStyle: { type: 'dashed', color: '#ccc' } }\n            //         },\n            //         series: [{\n            //             name: 'Daily Sales',\n            //             type: 'bar',\n            //             id: 'sales',\n            //             data: drilldownData.map(d => d.value),\n            //             barWidth: 20,\n            //             itemStyle: {\n            //                 color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\n            //                     { offset: 0, color: '#73c0de' },\n            //                     { offset: 1, color: '#3fb1e3' }\n            //                 ]),\n            //                 borderRadius: [4, 4, 0, 0]\n            //             },\n            //             universalTransition: {\n            //                 enabled: true,\n            //                 divideShape: 'clone'\n            //             }\n            //         }],\n            //         tooltip: {\n            //             trigger: 'axis',\n            //             axisPointer: { type: 'shadow' },\n            //             formatter: function (params) {\n            //                 const data = params[0];\n            //                 return `${data.name}<br/>Daily Sales: ${data.value}`;\n            //             }\n            //         },\n            //         legend: {\n            //           show: false\n            //         },\n            //         graphic: [{\n            //             type: 'text',\n            //             left: 50,\n            //             top: 20,\n            //             style: {\n            //                 text: 'Back',\n            //                 fontSize: 18,\n            //                 fill: '#333',\n            //                 cursor: 'pointer'\n            //             },\n            //             onclick: function () {\n            //                 myChart.setOption(option);\n                            \n            //                 window.addEventListener('resize', function() {\n            //                     myChart.resize();\n            //                 });\n            //             }\n            //         }]\n            //     });\n            // });\n            \n            myChart.setOption(option);\n                \n            window.addEventListener('resize', function() {\n                myChart.resize();\n            });\n            \n            window.addEventListener('load', function() {\n                myChart.resize();\n            });\n            \n            window.onload = (event) => {\n                myChart.resize();\n            };\n        } else {\n            console.error(\"The chart container with id starting 'chart-' was not found.\");\n        }\n    }, 1000);\n<\/script>",
